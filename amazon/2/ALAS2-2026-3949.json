  "id": "ALAS2-2026-3949",
  "title": "Amazon Linux 2 2017.12 - ALAS2-2026-3949: medium priority package update for policycoreutils",
  "issued": {
    "date": "2026-09-28 09:00:00"
  },
  "updated": {
    "date": "2026-09-28 09:00:00"
