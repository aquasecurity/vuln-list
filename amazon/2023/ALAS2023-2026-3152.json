  "title": "Amazon Linux 2023 - ALAS2023-2026-3152: Important priority package update for flatpak-builder",
  "issued": {
    "date": "2026-10-12 09:00:00"
  },
  "updated": {
    "date": "2026-10-12 11:14:00"
