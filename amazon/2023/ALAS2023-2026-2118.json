  "id": "ALAS2023-2026-2118",
  "title": "Amazon Linux 2023 - ALAS2023-2026-2118: Important priority package update for rsyslog",
  "issued": {
    "date": "2026-08-31 09:00:00"
  },
  "updated": {
    "date": "2026-08-31 09:00:00"
