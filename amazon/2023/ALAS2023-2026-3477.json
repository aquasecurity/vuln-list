  "id": "ALAS2023-2026-3477",
  "title": "Amazon Linux 2023 - ALAS2023-2026-3477: Important priority package update for kernel6.18",
  "issued": {
    "date": "2026-11-17 09:00:00"
  },
  "updated": {
    "date": "2026-11-17 04:40:33"
