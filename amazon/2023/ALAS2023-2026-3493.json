  "id": "ALAS2023-2026-3493",
  "title": "Amazon Linux 2023 - ALAS2023-2026-3493: Medium priority package update for gstreamer1-plugins-bad-free",
  "issued": {
    "date": "2026-11-19 09:00:00"
