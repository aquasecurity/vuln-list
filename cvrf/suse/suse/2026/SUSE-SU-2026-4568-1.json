  "Notes": [
    {
      "Text": "Security update for rpcbind",
      "Title": "Topic",
      "Type": "Summary"
    },
    {
      "Text": "This update for rpcbind fixes the following issues:\n\n- CVE-2026-16461: stack buffer overflow in rpcinfo rpcbdump() short-mode version-list formatting (bsc#1272340).\n- CVE-2026-94640: unbounded memory allocation in statistics tracking allows for unauthenticated remote denial of service\n  (bsc#1282326).\n",
      "Title": "Details",
      "Type": "General"
    },
