    {
      "CVE": "CVE-2026-105838",
      "Description": "libmikmod before 3.3.14 contains a heap out-of-bounds read vulnerability in the Impulse Tracker loader load_it.c that allows attackers to read adjacent heap memory via oversized patterns. Attackers can supply a crafted IT module with more than 200 pattern rows, causing IT_ConvertTrack() to read past the itpat buffer and crash applications.",
      "Threats": [
        {
          "Type": "Impact",
          "Severity": "important"
        }
      ],
