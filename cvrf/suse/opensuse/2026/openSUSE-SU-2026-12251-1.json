          "Type": "Fixed",
          "ProductID": [
            "openSUSE Tumbleweed:python313-Pillow-13.0.0-2.1",
            "openSUSE Tumbleweed:python313-Pillow-tk-13.0.0-2.1",
            "openSUSE Tumbleweed:python314-Pillow-13.0.0-2.1",
            "openSUSE Tumbleweed:python314-Pillow-tk-13.0.0-2.1"
          ]
        }
      ],
