      "CVE": "CVE-2026-119339",
      "Description": "Tesseract is an open source OCR engine. Prior to 5.5.4, WeightMatrix::DeSerialize trusts a mode byte from a traineddata LSTM network and calls WeightMatrix::DeSerializeOld when kDoubleFlag is clear. In default FAST_FLOAT builds, DeSerializeOld invokes ASSERT_HOST instead of returning an error, so loading a crafted model through TessBaseAPI::Init terminates the process and causes denial of service. This issue is fixed in version 5.5.4.",
      "Threats": [
        {
          "Type": "Impact",
          "Severity": "moderate"
        }
      ],
      "References": [
        {
          "URL": "https://www.suse.com/security/cve/CVE-2026-119339.html",
          "Description": "CVE-2026-119339"
        },
        {
          "URL": "https://bugzilla.suse.com/1289082",
          "Description": "SUSE Bug 1289082"
        }
      ],
      "ProductStatuses": [
        {
          "Type": "Fixed",
          "ProductID": [
            "openSUSE Tumbleweed:libtesseract5-5.5.4-2.1",
            "openSUSE Tumbleweed:libtesseract5-x86-64-v3-5.5.4-2.1",
            "openSUSE Tumbleweed:tesseract-ocr-5.5.4-2.1",
            "openSUSE Tumbleweed:tesseract-ocr-common-5.5.4-2.1",
            "openSUSE Tumbleweed:tesseract-ocr-devel-5.5.4-2.1"
          ]
        }
      ],
      "CVSSScoreSets": {}
    },
    {
      "CVE": "CVE-2026-119340",
      "Description": "Tesseract is an open source OCR engine. Prior to 5.5.4, GENERIC_2D_ARRAY::DeSerializeSize in src/ccstruct/matrix.h reads matrix dimensions as signed int32_t values and compares them only with UINT16_MAX, allowing negative values to reach ResizeNoInit. Negative dimensions or a 65535 by 65535 product can create inconsistent allocation state and later out-of-bounds accesses while loading a crafted traineddata file, causing denial of service. This issue is fixed in version 5.5.4.",
      "Threats": [
        {
          "Type": "Impact",
          "Severity": "moderate"
        }
      ],
      "References": [
        {
          "URL": "https://www.suse.com/security/cve/CVE-2026-119340.html",
          "Description": "CVE-2026-119340"
        },
