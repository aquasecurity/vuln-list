  "Vulnerabilities": [
    {
      "CVE": "CVE-2026-116130",
      "Description": "HTTP::Parser::XS versions before 0.18 for Perl truncate PATH_INFO at an encoded NUL byte in parse_http_request.\n\nThe XS parser URL-decodes the request path and measures the result with strlen(), so PATH_INFO ends at the first byte decoded from %00. The pure-Perl backend is not affected.\n\nA remote attacker can send a path that a proxy or filter checks in full while the application routes on a shorter one.",
      "Threats": [
        {
          "Type": "Impact",
          "Severity": "moderate"
        }
