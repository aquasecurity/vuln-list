  "Notes": [
    {
      "Text": "Security update for NetworkManager",
      "Title": "Topic",
      "Type": "Summary"
    },
    {
      "Text": "This update for NetworkManager fixes the following issues:\n\n- CVE-2026-10805: local privilege escalation via malformed MUD URLs in dhclient backend (bsc#1267696).\n- CVE-2026-19685: missing user ownership checks for 802.1X directory properties can allow WPA-Enterprise server\n  certificate validation bypass (bsc#1276764).\n",
      "Title": "Details",
      "Type": "General"
    },
