  "Vulnerabilities": [
    {
      "CVE": "CVE-2026-132145",
      "Description": "A flaw was found in rsyslog. When using the Datagram Transport Layer Security (DTLS) output module (omdtls) configured to authenticate receivers by name or fingerprint, the module validates the certificate chain against trusted certificate authorities but fails to verify that the certificate matches the intended receiver's identity or fingerprint. An attacker who can redirect or intercept outbound network traffic and present a certificate issued by a trusted certificate authority could capture forwarded log data, leading to information disclosure.",
      "Threats": [
        {
          "Type": "Impact",
          "Severity": "moderate"
        }
