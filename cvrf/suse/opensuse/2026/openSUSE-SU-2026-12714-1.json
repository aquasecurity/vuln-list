  "Vulnerabilities": [
    {
      "CVE": "CVE-2026-135092",
      "Description": "PDF::API2 versions before 2.049 for Perl allow unbounded recursion via circular cross-reference chains in readxrtr.\n\nWhen a PDF is opened, readxrtr reads each cross-reference table and calls itself on the offset in the trailer's /Prev entry. Nothing records which offsets it has already read, so a /Prev entry pointing back to an earlier table, or to its own, makes it recurse without end.\n\nAn attacker who supplies a crafted PDF can cause a denial of service in any application that opens it.",
      "Threats": [
        {
          "Type": "Impact",
          "Severity": "moderate"
        }
      ],
